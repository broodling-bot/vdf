use vdf::{modmul, modpow, limbs_eq, verify_vdf, N_LIMBS, L_LIMBS};

#[cfg(test)]
mod tests {
    use super::*;

    // Gas-cheap checks that exercise both limb domains. The full
    // Wesolowski verification needs more than cairo-test's 2^32 gas cap;
    // run it via `scarb execute` (gas off) instead — see README.
    #[test]
    fn modmul_x_squared() {
        let N = array![1898351161591533825, 4356387828846098588, 15104507554077691313, 6876313996961890971, 13240527996779759445, 15410035925011366394, 1076452945407771301, 7657677598516140765].span();
        let mu_n = array![10950687991304081787, 2098051903755596314, 17403214308062555454, 4922824657442274903, 5539076167267632777, 6561758054951799186, 9589865281674993437, 7543269935328642287, 2].span();
        let x = array![13806245889880775587, 15679777442770149759, 500920718577896886, 5573474882017304535, 10518943416611605599, 7172549684559914742, 1052609501633411169, 67798335345670532].span();
        let got = modmul(x, x, N, mu_n, N_LIMBS);
        let exp = array![10352095994714786986, 8960377070039690578, 10237075417565750292, 5275060624612680655, 4189679531130111620, 3106786650610682103, 15428413525564863836, 4673250175685126284].span();
        assert(limbs_eq(got.span(), exp, N_LIMBS), 'x^2 mod N');
    }

    #[test]
    fn r_calc_2_to_T_mod_L() {
        let L = array![16560192158362901263, 13501075083826558208, 3132384150755646536, 10762026132417164332].span();
        let mu_l = array![2587205249755788958, 7166301011594585874, 14472805833152736365, 13172057324286182900, 1].span();
        let T_limbs = array![65536, 0].span();
        let mut two = ArrayTrait::new();
        two.append(2);
        let mut i: usize = 1;
        while i < L_LIMBS {
            two.append(0);
            i += 1;
        }
        let got = modpow(two.span(), T_limbs, 2, L, mu_l, L_LIMBS);
        let exp = array![7548684012500414730, 9449975810861830761, 14105664804910742066, 3870894576904556030].span();
        assert(limbs_eq(got.span(), exp, L_LIMBS), '2^T mod L');
    }

    // Full Wesolowski check — passes via scarb execute (gas off),
    // exceeds cairo-test's gas cap so it is ignored here.
    #[test]
    #[ignore]
    fn full_wesolowski_verifies() {
        let N = array![1898351161591533825, 4356387828846098588, 15104507554077691313, 6876313996961890971, 13240527996779759445, 15410035925011366394, 1076452945407771301, 7657677598516140765].span();
        let mu_n = array![10950687991304081787, 2098051903755596314, 17403214308062555454, 4922824657442274903, 5539076167267632777, 6561758054951799186, 9589865281674993437, 7543269935328642287, 2].span();
        let x = array![13806245889880775587, 15679777442770149759, 500920718577896886, 5573474882017304535, 10518943416611605599, 7172549684559914742, 1052609501633411169, 67798335345670532].span();
        let y = array![8168040046237677685, 8599764202932158601, 4462640674110688760, 13325850887455948455, 17918271064666316549, 14780950774547718174, 2156076764397268394, 1301903697396525593].span();
        let pi = array![11723944937132688706, 1653276608711426850, 12676007696365490959, 10367800270058066830, 4432245215571215299, 10677360709179266082, 4615633897529965240, 1517617388775166619].span();
        let L = array![16560192158362901263, 13501075083826558208, 3132384150755646536, 10762026132417164332].span();
        let mu_l = array![2587205249755788958, 7166301011594585874, 14472805833152736365, 13172057324286182900, 1].span();
        let r = array![7548684012500414730, 9449975810861830761, 14105664804910742066, 3870894576904556030].span();
        let T_limbs = array![65536, 0].span();
        assert(verify_vdf(N, mu_n, x, y, pi, L, mu_l, r, T_limbs, 2), 'vdf');
    }
}
